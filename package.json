{
  "name": "coopq",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant co-op game tracker. Cloudflare Pages + D1 + Steam login.",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "wrangler pages dev",
    "db:create": "wrangler d1 create g4m1ng",
    "db:seed": "wrangler d1 execute g4m1ng --remote --file=./seed.sql",
    "db:init:local": "wrangler d1 execute g4m1ng --local --file=./schema.sql && wrangler d1 execute g4m1ng --local --file=./seed.sql",
    "db:backup": "wrangler d1 export g4m1ng --remote --output=backup.sql",
    "db:migrate": "wrangler d1 execute g4m1ng --remote --yes",
    "crawl:coop": "node scripts/crawl-coop.mjs",
    "measure:caps": "node scripts/measure-igdb-caps.mjs",
    "deploy": "wrangler pages deploy --branch main",
    "deploy:preview": "wrangler pages deploy",
    "test": "node test/isolation.mjs",
    "test:ui": "node test/shots.mjs"
  },
  "devDependencies": {
    "hls.js": "^1.6.17",
    "wrangler": "^4.120.0"
  }
}
